# ──────────────────────────────────────────────────────────────────────────────
# Twitter Account 1 (Primary — required for twscrape)
# Get cookies from x.com: F12 → Application → Cookies → auth_token & ct0
# ──────────────────────────────────────────────────────────────────────────────
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email@gmail.com
TWITTER_EMAIL_PASSWORD=your_email_password
TWITTER_AUTH_TOKEN=your_auth_token_cookie_value
TWITTER_CT0=your_ct0_cookie_value

# ──────────────────────────────────────────────────────────────────────────────
# Twitter Account 2 (Optional backup — used when Account 1 is rate-limited)
# Add a second Twitter account to double your search capacity.
# Set the same variables with _2 suffix.
# ──────────────────────────────────────────────────────────────────────────────
TWITTER_USERNAME_2=your_second_twitter_username
TWITTER_PASSWORD_2=your_second_twitter_password
TWITTER_EMAIL_2=your_second_email@gmail.com
TWITTER_EMAIL_PASSWORD_2=your_second_email_password
TWITTER_AUTH_TOKEN_2=your_second_auth_token_cookie_value
TWITTER_CT0_2=your_second_ct0_cookie_value

# ──────────────────────────────────────────────────────────────────────────────
# Twitter API v2 (Optional paid fallback — Basic tier required)
# ──────────────────────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# ──────────────────────────────────────────────────────────────────────────────
# Flask Settings
# ──────────────────────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=True
